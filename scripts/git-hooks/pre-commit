#!/bin/sh
# Three gates for shared/ <-> generated trees and generator correctness.
# The standalone gates 3 (conformance-baseline drift, report-conformance.py
# --check) and 5 (claim-surface drift, gen-gate-docs.py --check) moved out of
# the hooks (D-01, D-02). Conformance drift therefore no longer blocks a commit;
# it runs only in the offline battery (inline CONF-DRIFT). Claim-surface drift
# STILL blocks a commit: gen-gate-docs.py --self-test (below) drives
# main(["--check"]) against the working tree (controls check-dispatch-wired and
# nondeterminism-exit-2), in both modes, including SKIP_DRIFT_CHECK=1. Its
# standalone --check also runs in the battery and CI as CONF-SURFACE.
# Installed by scripts/install-hooks.sh as .git/hooks/pre-commit (symlink).
#
# Mirrors .githooks/pre-commit verbatim (module logic; header prose
# and printf-vs-echo usage differ cosmetically between the two files, a
# pre-existing asymmetry). The body-budget gate that used to run here was
# retired under TEARDOWN-01 (docs/v8.7-constraint-teardown.md); its report-only
# reporter script and the battery's untallied [INFO] body-size line were
# themselves retired under docs/v9.4-gate-retirement.md section 2.5 -- nothing
# reports or gates the agent body's line count anymore (see docs/TESTING.md
# for the wc -l command that reads it manually).
#
# Gate 1 -- sync-drift gate: blocks if shared/ and the generated tree have
# diverged (scripts/sync-content.py --check).
# Gate 2 -- conformance generator self-test: blocks if
# scripts/report-conformance.py --self-test fails. Runs the generator's own
# falsifiability controls before its output is compared to anything (WR-05).
# Gate 3 (REMOVED, D-01) -- conformance-baseline drift gate: now runs in the
# offline battery as inline check CONF-DRIFT (Phase 90).
# Gate 4 -- claim-surface generator self-test: blocks if
# scripts/gen-gate-docs.py --self-test fails. Same WR-05 ordering rationale
# as Gate 2 -- a broken generator's own controls must be caught before any
# comparison against committed output is attempted.
# Gate 5 (REMOVED, D-02) -- standalone claim-surface drift gate: runs in the
# battery and CI as CONF-SURFACE; its comparison still runs here inside Gate 4.
#
# POSIX sh only -- no bashisms. Quote all expansions.

set -eu

cd "$(git rev-parse --show-toplevel)"

# Bytecode cache begins empty and dies with this run, so a same-size edit made
# within the same second is never served stale bytecode from an earlier run
# (see scripts/check-firewall-battery.sh). Children inherit it.
PYCACHE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fp-hook-pycache.XXXXXX")
trap 'rm -rf "$PYCACHE_DIR"' EXIT
export PYTHONPYCACHEPREFIX="$PYCACHE_DIR"

# --- Interpreter resolution --------------------------------------------------

if command -v uv >/dev/null 2>&1; then
    # "uv run python3", not "uv run" (bare script path): the bare form makes
    # uv build a fresh per-script PEP-723-isolated environment that ignores
    # uv.lock and the project's declared dev dependencies -- documented in
    # CLAUDE.md and already followed by every CI job. Gate 4's
    # scripts/gen-gate-docs.py subprocess-invokes several sibling scripts via
    # sys.executable (D-21-A); under bare "uv run scripts/gen-gate-docs.py"
    # that interpreter has none of PyYAML those siblings need, and harvest()
    # silently degrades to a D-04-floor-violation exit rather than the
    # intended CONF-13 residual check. "uv run python3" runs every gate
    # against the same project-locked .venv sys.executable resolves inside.
    PY="uv run python3"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
else
    printf "pre-commit: neither 'uv' nor 'python3' on PATH.\n" >&2
    printf "  Install one of them, or bypass this hook with 'git commit --no-verify'.\n" >&2
    exit 2
fi

# --- Fast-path: SKIP_DRIFT_CHECK for regeneration workflows --------
# SKIP_DRIFT_CHECK=1 skips exactly one gate: the sync-drift gate
# (sync-content.py --check). Both self-tests still run, and the claim-surface
# self-test still compares the generated surfaces against the working tree, so
# stale gen-gate-docs.py output blocks the commit in this mode too:
#   SKIP_DRIFT_CHECK=1 git commit
#
# This skips only the sync-drift gate; CI (DUAL-04) and the battery still run it.
# Use only when intentionally regenerating outputs. CI runs sync-drift
# (DUAL-04) and claim-surface drift (CONF-SURFACE) on every PR; conformance
# drift (CONF-DRIFT) runs only in the offline battery, which no CI job runs --
# run bash scripts/check-firewall-battery.sh before pushing.
# ---------------------------------------------------------------------

# --- Gate execution: SKIP_DRIFT_CHECK conditional wrapper --------

if [ "${SKIP_DRIFT_CHECK:-0}" = "1" ]; then
    # Fast-path: run only self-tests (which verify generators are not broken),
    # skip drift checks (which fail when outputs naturally change).
    printf "pre-commit: SKIP_DRIFT_CHECK=1 — skipping the sync-drift check; generator self-tests still run (gen-gate-docs --self-test still compares claim surfaces)\n" >&2

    # Gate 2: conformance generator self-test
    $PY scripts/report-conformance.py --self-test || exit $?

    # Gate 3: claim-surface generator self-test (terminal)
    $PY scripts/gen-gate-docs.py --self-test
else
    # Normal mode: run all gates (drift checks + self-tests)

    # --- Gate 1: sync-drift gate (preserved verbatim from prior version) --------
    # Not exec'd -- two more gates follow, so its exit status is propagated
    # explicitly with "|| exit $?" rather than replacing the shell process with
    # it. A failing sync check must not be silently replaced by a passing
    # conformance check, or the reverse.

    $PY scripts/sync-content.py --check || exit $?

    # --- Gate 2: conformance generator self-test ---------------------------------
    # WR-05 (Phase 20 20-REVIEW): the generator's own falsifiability battery ran
    # nowhere automated -- no CI job, no scripts/check-firewall-battery.sh
    # registration, and both hooks ran only --check. Its controls therefore
    # executed only when a human typed the command, which is the direct reason a
    # missing positive arm (CR-02) shipped able to hide the deletion of an entire
    # enforcement floor with --self-test and --check both green.
    #
    # --check no longer runs in this hook (Phase 89 D-01); it runs in the battery
    # as inline CONF-DRIFT (Phase 90). Costs ~0.1s. Not exec'd -- one more gate
    # follows.
    #
    # This --self-test is deliberately NOT registered in
    # scripts/check-firewall-battery.sh (only --check is, as CONF-DRIFT); that
    # decision, and why, is recorded in that file's header.
    #

    $PY scripts/report-conformance.py --self-test || exit $?

    # --- Gate 3: claim-surface generator self-test (terminal) --------------------
    # Same WR-05 ordering discipline as Gate 2, for scripts/gen-gate-docs.py
    # (CONF-SURFACE, D-21-C, plan 21-11): the generator's own controls must be
    # caught as the final pre-commit check. Terminal, but not exec'd: exec would
    # skip the EXIT trap that removes the per-run bytecode cache directory. As the
    # last command, its exit status is the hook's.

    $PY scripts/gen-gate-docs.py --self-test
fi
