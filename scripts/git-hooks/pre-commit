#!/bin/sh
# Five gates for shared/ <-> generated trees, the conformance baseline, and
# the CI-gate claim surface.
# Installed by scripts/install-hooks.sh as .git/hooks/pre-commit (symlink).
#
# Gate 1 -- sync-drift gate: blocks if shared/ and the generated tree have
# diverged (scripts/sync-content.py --check). The body-budget gate that used
# to run alongside it was retired under TEARDOWN-01
# (docs/v8.7-constraint-teardown.md); its report-only reporter script and the
# battery's untallied [INFO] body-size line were themselves retired under
# docs/v9.4-gate-retirement.md section 2.5 -- nothing reports or gates the
# agent body's line count anymore (see docs/TESTING.md for the wc -l command
# that reads it manually).
# Gate 2 -- conformance generator self-test: blocks if
# scripts/report-conformance.py --self-test fails. Runs the generator's own
# falsifiability controls before its output is compared to anything (WR-05).
# Gate 3 -- conformance-baseline drift gate: blocks if
# docs/conformance-baseline.md / docs/data/conformance.json no longer match a
# fresh run (scripts/report-conformance.py --check). This fails on STALENESS
# of the committed baseline relative to a fresh measurement, never on a
# conformance count being too high -- no count in that baseline gates
# anything. By decision D-06 report-conformance.py's own controls are
# deliberately NOT registered a second time in scripts/check-firewall-battery.sh
# and NOT added to .github/workflows/validation.yml -- they run here, at
# commit time, instead.
# Gate 4 -- claim-surface generator self-test: blocks if
# scripts/gen-gate-docs.py --self-test fails. Same WR-05 ordering rationale
# as Gate 2 -- a broken generator's own controls must be caught before its
# comparison against committed output (Gate 5) is even attempted.
# Gate 5 -- claim-surface drift gate: blocks if CLAUDE.md's/
# docs/ARCHITECTURE.md's generated gate tables, docs/TESTING.md's generated
# index, or any docs/gates/<ID>.md page no longer match a fresh
# scripts/gen-gate-docs.py --write run, or if CONF-13's standing literal
# scanner finds a non-exempt hand-maintained count literal
# (scripts/gen-gate-docs.py --check). CONF-SURFACE (D-21-C, plan 21-11) --
# also registered in scripts/check-firewall-battery.sh with a matching
# gen-gate-docs (CONF-SURFACE) CI job, unlike Gates 2/3's generator.
#
# POSIX sh only -- no bashisms. Quote all expansions.

set -eu

cd "$(git rev-parse --show-toplevel)"

# --- Interpreter resolution --------------------------------------------------

if command -v uv >/dev/null 2>&1; then
    # "uv run python3", not "uv run" (bare script path): the bare form makes
    # uv build a fresh per-script PEP-723-isolated environment that ignores
    # uv.lock and the project's declared dev dependencies -- documented in
    # CLAUDE.md and already followed by every CI job. Gate 4/5's
    # scripts/gen-gate-docs.py subprocess-invokes several sibling scripts via
    # sys.executable (D-21-A); under bare "uv run scripts/gen-gate-docs.py"
    # that interpreter has none of PyYAML those siblings need, and harvest()
    # silently degrades to a D-04-floor-violation exit rather than the
    # intended CONF-13 residual check. "uv run python3" runs every gate
    # against the same project-locked .venv sys.executable resolves inside.
    PY="uv run python3"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
else
    printf "pre-commit: neither 'uv' nor 'python3' on PATH.\n" >&2
    printf "  Install one of them, or bypass this hook with 'git commit --no-verify'.\n" >&2
    exit 2
fi

# --- Gate 1: sync-drift gate (compositional preservation) --------------------
# Not exec'd -- four more gates follow, so its exit status is propagated
# explicitly with "|| exit $?" rather than replacing the shell process with
# it. A failing sync check must not be silently replaced by a passing
# conformance check, or the reverse.

$PY scripts/sync-content.py --check || exit $?

# --- Gate 2: conformance generator self-test ---------------------------------
# WR-05 (Phase 20 20-REVIEW): the generator's own falsifiability battery ran
# nowhere automated -- no CI job, no scripts/check-firewall-battery.sh
# registration, and both hooks ran only --check. Its controls therefore
# executed only when a human typed the command, which is the direct reason a
# missing positive arm (CR-02) shipped able to hide the deletion of an entire
# enforcement floor with --self-test and --check both green.
#
# Ordered BEFORE --check on purpose: --check compares the committed baseline
# against a fresh run of this same generator, so a generator whose own controls
# are failing makes that comparison meaningless. Costs ~0.1s. Not exec'd --
# three more gates follow.
#
# Deliberately NOT registered in scripts/check-firewall-battery.sh; that
# decision, and why, is recorded in that file's header.

$PY scripts/report-conformance.py --self-test || exit $?

# --- Gate 3: conformance-baseline drift gate ---------------------------------
# Not exec'd -- two more gates follow.

$PY scripts/report-conformance.py --check || exit $?

# --- Gate 4: claim-surface generator self-test -------------------------------
# Same WR-05 ordering discipline as Gate 2, for scripts/gen-gate-docs.py
# (CONF-SURFACE, D-21-C, plan 21-11): the generator's own controls must be
# caught before Gate 5 compares its output to the committed tree, since that
# comparison is meaningless if the generator itself is broken. Not exec'd --
# one more gate follows.

$PY scripts/gen-gate-docs.py --self-test || exit $?

# --- Gate 5: claim-surface drift gate ----------------------------------------
# Terminal check -- only this one may use exec, because nothing follows it.

exec $PY scripts/gen-gate-docs.py --check
