#!/bin/sh
# Three gates for shared/ <-> generated trees and generator correctness.
# Gates 3 (conformance-baseline drift) and 5 (claim-surface drift) moved to
# battery-only (D-01, D-02), allowing commits when output naturally changes.
# Opt in:  git config core.hooksPath .githooks
#
# Mirrors scripts/git-hooks/pre-commit verbatim (module logic; header prose
# and printf-vs-echo usage differ cosmetically between the two files, a
# pre-existing asymmetry). The body-budget gate that used to run here was
# retired under TEARDOWN-01 (docs/v8.7-constraint-teardown.md); its report-only
# reporter script and the battery's untallied [INFO] body-size line were
# themselves retired under docs/v9.4-gate-retirement.md section 2.5 -- nothing
# reports or gates the agent body's line count anymore (see docs/TESTING.md
# for the wc -l command that reads it manually).
#
# Gate 1 -- sync-drift gate: blocks if shared/ and the generated tree have
# diverged (scripts/sync-content.py --check).
# Gate 2 -- conformance generator self-test: blocks if
# scripts/report-conformance.py --self-test fails. Runs the generator's own
# falsifiability controls before its output is compared to anything (WR-05).
# Gate 3 (REMOVED, D-01) -- conformance-baseline drift gate: now battery-only.
# Gate 4 -- claim-surface generator self-test: blocks if
# scripts/gen-gate-docs.py --self-test fails. Same WR-05 ordering rationale
# as Gate 2 -- a broken generator's own controls must be caught before any
# comparison against committed output is attempted.
# Gate 5 (REMOVED, D-02) -- claim-surface drift gate: now battery-only.

set -eu

cd "$(git rev-parse --show-toplevel)"

# --- Interpreter resolution --------------------------------------------------

if command -v uv >/dev/null 2>&1; then
    # "uv run python3", not "uv run" (bare script path): the bare form makes
    # uv build a fresh per-script PEP-723-isolated environment that ignores
    # uv.lock and the project's declared dev dependencies -- documented in
    # CLAUDE.md and already followed by every CI job. Gate 4/5's
    # scripts/gen-gate-docs.py subprocess-invokes several sibling scripts via
    # sys.executable (D-21-A); under bare "uv run scripts/gen-gate-docs.py"
    # that interpreter has none of PyYAML those siblings need, and harvest()
    # silently degrades to a D-04-floor-violation exit rather than the
    # intended CONF-13 residual check. "uv run python3" runs every gate
    # against the same project-locked .venv sys.executable resolves inside.
    PY="uv run python3"
elif command -v python3 >/dev/null 2>&1; then
    PY="python3"
else
    echo "pre-commit: neither 'uv' nor 'python3' on PATH." >&2
    echo "  Install one of them, or bypass this hook with 'git commit --no-verify'." >&2
    exit 2
fi

# --- Gate 1: sync-drift gate (preserved verbatim from prior version) --------
# Not exec'd -- four more gates follow, so its exit status is propagated
# explicitly with "|| exit $?" rather than replacing the shell process with
# it. A failing sync check must not be silently replaced by a passing
# conformance check, or the reverse.

$PY scripts/sync-content.py --check || exit $?

# --- Gate 2: conformance generator self-test ---------------------------------
# WR-05 (Phase 20 20-REVIEW): the generator's own falsifiability battery ran
# nowhere automated -- no CI job, no scripts/check-firewall-battery.sh
# registration, and both hooks ran only --check. Its controls therefore
# executed only when a human typed the command, which is the direct reason a
# missing positive arm (CR-02) shipped able to hide the deletion of an entire
# enforcement floor with --self-test and --check both green.
#
# Ordered BEFORE --check on purpose: --check compares the committed baseline
# against a fresh run of this same generator, so a generator whose own controls
# are failing makes that comparison meaningless. Costs ~0.1s. Not exec'd --
# three more gates follow.
#
# Deliberately NOT registered in scripts/check-firewall-battery.sh; that
# decision, and why, is recorded in that file's header.

$PY scripts/report-conformance.py --self-test || exit $?

# --- Gate 3: claim-surface generator self-test (terminal) --------------------
# Same WR-05 ordering discipline as Gate 2, for scripts/gen-gate-docs.py
# (CONF-SURFACE, D-21-C, plan 21-11): the generator's own controls must be
# caught as the final pre-commit check. Terminal -- only this one may use exec.

exec $PY scripts/gen-gate-docs.py --self-test
