#!/bin/sh
# Sync drift gate AND body-budget gate for shared/ <-> generated trees.
# Opt in:  git config core.hooksPath .githooks

set -eu

cd "$(git rev-parse --show-toplevel)"

# --- Body-budget gate (HOOK-03) ---------------------------------------------
# Mirrors scripts/git-hooks/pre-commit verbatim so contributors who opted in
# via core.hooksPath get the same coverage as those who used install-hooks.sh.

ALLOWLIST='first-principles/agents/first-principles.md
shared/spine/SKILL-body.md
shared/spine/input-contract.md
shared/spine/SKILL.meta.yml
shared/spine/references/output-template.md
shared/spine/references/validation-rubric.md
scripts/sync-content.py'

STAGED=$(git diff --cached --name-only -z | tr '\0' '\n')

BODY_AFFECTED=0
if [ -n "$STAGED" ]; then
    OLD_IFS=$IFS
    IFS='
'
    for path in $ALLOWLIST; do
        if printf '%s\n' "$STAGED" | grep -Fxq "$path"; then
            BODY_AFFECTED=1
            break
        fi
    done
    IFS=$OLD_IFS
fi

if [ "$BODY_AFFECTED" = "1" ]; then
    if command -v uv >/dev/null 2>&1; then
        if ! uv run scripts/check-body-budget.py; then
            printf 'pre-commit: body budget exceeded.\n' >&2
            printf "  The generated agent body would push past MAX_LINES=580 with the changes you're committing.\n" >&2
            printf '  Bypass (intentional in-progress work):  git commit --no-verify\n' >&2
            exit 1
        fi
    elif command -v python3 >/dev/null 2>&1; then
        if ! python3 scripts/check-body-budget.py; then
            printf 'pre-commit: body budget exceeded.\n' >&2
            printf "  The generated agent body would push past MAX_LINES=580 with the changes you're committing.\n" >&2
            printf '  Bypass (intentional in-progress work):  git commit --no-verify\n' >&2
            exit 1
        fi
    else
        echo "pre-commit: neither 'uv' nor 'python3' on PATH." >&2
        echo "  Install one of them, or bypass this hook with 'git commit --no-verify'." >&2
        exit 2
    fi
fi

# --- Sync-drift gate (preserved verbatim from prior version) ----------------

if command -v uv >/dev/null 2>&1; then
    exec uv run scripts/sync-content.py --check
elif command -v python3 >/dev/null 2>&1; then
    exec python3 scripts/sync-content.py --check
else
    echo "pre-commit: neither 'uv' nor 'python3' on PATH." >&2
    echo "  Install one of them, or bypass this hook with 'git commit --no-verify'." >&2
    exit 2
fi
